# Copy this file to .env and fill only the providers you enable.
# Never commit real credentials.

# OpenAI-compatible chat/execution endpoint (required for live chat).
API_SECRET_KEY=
# OPENAI_API_KEY=             # Alternative to API_SECRET_KEY.
BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional DeepSeek example client.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-reasoner

# Optional Alibaba embedding/rerank integration.
ALIBABA_API_KEY=
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_EMBED_MODEL=text-embedding-v4
ALIBABA_RERANK_MODEL=

# Optional Neo4j integration.
NEO4J_PASSWORD=

# Optional web-search providers. Configure only the selected provider.
YDC_API_KEY=
TAVILY_API_KEY=

# Optional storage/config overrides for installed deployments.
# M_AGENT_HOME=/absolute/path/to/runtime-home
# M_AGENT_CONFIG_DIR=/absolute/path/to/config
# M_AGENT_DATA_DIR=/absolute/path/to/data
# M_AGENT_MEMORY_ROOT=/absolute/path/to/memory
# M_AGENT_SECRETS_DIR=/absolute/path/to/secrets

# Optional image-caption integration. The default provider reuses the
# OpenAI-compatible credentials above.
# CHAT_IMAGE_CAPTION_PROVIDER=openai
# CHAT_IMAGE_CAPTION_OPENAI_MODEL=gpt-4.1-mini
# CHAT_IMAGE_CAPTION_OPENAI_API_KEY=
# CHAT_IMAGE_CAPTION_OPENAI_BASE_URL=
