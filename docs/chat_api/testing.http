@baseUrl = http://127.0.0.1:8777
@username = demo_user
@password = password123
@accessToken = paste_access_token_here
@threadId = demo-thread
@runId = run_xxx
@dialogueId = chat_xxx
@scheduleId = sch_xxx
@transactionId = tx_xxx
@transactionRevision = 1
@deleteIdempotencyKey = delete-demo-001
@afterSeq = 0
@sceneBeforeSeq = 1000000
@imageFile = ./test-image.png
@dialogueFile = ./dialogue.json

### Health
GET {{baseUrl}}/healthz

### Auth
### Skip this group when the server runs with --disable-auth.

POST {{baseUrl}}/v1/auth/register
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}",
  "role": "basic",
  "display_name": "Demo User",
  "assistant_name": "Memory Assistant",
  "persona_prompt": "Be concise and helpful."
}

###

POST {{baseUrl}}/v1/auth/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

###

GET {{baseUrl}}/v1/auth/me
Authorization: Bearer {{accessToken}}

###

POST {{baseUrl}}/v1/auth/logout
Authorization: Bearer {{accessToken}}

### User config

GET {{baseUrl}}/v1/users/me/config/schema
Authorization: Bearer {{accessToken}}

###

PATCH {{baseUrl}}/v1/users/me/config
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "chat": {
    "chat_assistant_name": "Memory Assistant",
    "chat_persona_prompt": "Please answer in concise Chinese."
  }
}

### Image upload
### The server must have a working CHAT_IMAGE_CAPTION_PROVIDER configuration.
### Supported types: JPEG, PNG, WebP, GIF; maximum size: 10 MiB.
# @name uploadImage
POST {{baseUrl}}/v1/chat/uploads/images
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=ImageBoundary

--ImageBoundary
Content-Disposition: form-data; name="thread_id"

{{threadId}}
--ImageBoundary
Content-Disposition: form-data; name="file"; filename="test-image.png"
Content-Type: image/png

< {{imageFile}}
--ImageBoundary--

###
### Verify the stored bytes through the owner-scoped content route.
GET {{baseUrl}}/v1/chat/uploads/images/{{uploadImage.response.body.$.upload_id}}/content
Authorization: Bearer {{accessToken}}

### Chat run

POST {{baseUrl}}/v1/chat/runs
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "thread_id": "{{threadId}}",
  "message": "Please summarize the main points we discussed before."
}

###
### Chat run with the metadata returned by the image upload.
### Current Runtime projects only the first attachment into user_turn.
POST {{baseUrl}}/v1/chat/runs
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "thread_id": "{{threadId}}",
  "message": "Use this image as context for the current task.",
  "attachments": [
    {
      "upload_id": "{{uploadImage.response.body.$.upload_id}}",
      "image_url": "{{uploadImage.response.body.$.image_url}}",
      "blip_caption": "{{uploadImage.response.body.$.blip_caption}}",
      "mime_type": "{{uploadImage.response.body.$.mime_type}}"
    }
  ]
}

###

GET {{baseUrl}}/v1/chat/runs/{{runId}}
Authorization: Bearer {{accessToken}}

### SSE note
### Use streaming fetch() in an authenticated browser; native EventSource cannot set Authorization.
### Never put accessToken in the URL. The server ignores Last-Event-ID; reconnect with after_seq.
### curl -N -H "Authorization: Bearer <token>" "{{baseUrl}}/v1/chat/runs/{{runId}}/events"

GET {{baseUrl}}/v1/chat/runs/{{runId}}/events?after_seq={{afterSeq}}
Authorization: Bearer {{accessToken}}

### Thread events
### This stream is for memory flush and schedule lifecycle events.
### curl -N -H "Authorization: Bearer <token>" "{{baseUrl}}/v1/chat/threads/{{threadId}}/events?after_seq=0"

GET {{baseUrl}}/v1/chat/threads/{{threadId}}/events?after_seq={{afterSeq}}
Authorization: Bearer {{accessToken}}

### Submit a user stimulus asynchronously
### ThreadStimulusRequest.kind and priority_override are currently NOT forwarded to Runtime.
### Omit both fields; this endpoint always submits user_message at the default user priority.
# @name enqueueStimulus
POST {{baseUrl}}/v1/chat/threads/{{threadId}}/stimuli
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "text": "Continue the existing task with this new information.",
  "attachments": [
    {
      "upload_id": "{{uploadImage.response.body.$.upload_id}}",
      "image_url": "{{uploadImage.response.body.$.image_url}}",
      "blip_caption": "{{uploadImage.response.body.$.blip_caption}}",
      "mime_type": "{{uploadImage.response.body.$.mime_type}}"
    }
  ]
}

###
### Run after the 202 response; poll until the submitted stimulus is attributed.
GET {{baseUrl}}/v1/chat/threads/{{threadId}}/transactions?include_history=false
Authorization: Bearer {{accessToken}}

###
### Use include_history=true only for a thread-wide audit across conversations.
GET {{baseUrl}}/v1/chat/threads/{{threadId}}/transactions?include_history=true
Authorization: Bearer {{accessToken}}

###
### Scene seq is independent from run/thread SSE seq.
GET {{baseUrl}}/v1/chat/threads/{{threadId}}/scene?limit=40&since_flush=true
Authorization: Bearer {{accessToken}}

###
GET {{baseUrl}}/v1/chat/threads/{{threadId}}/scene?limit=40&before_seq={{sceneBeforeSeq}}&since_flush=false
Authorization: Bearer {{accessToken}}

###
### Optional destructive control: paste transaction_id/revision from the transaction response above.
DELETE {{baseUrl}}/v1/chat/threads/{{threadId}}/transactions/{{transactionId}}
Authorization: Bearer {{accessToken}}
If-Match: W/"{{transactionRevision}}"
Idempotency-Key: {{deleteIdempotencyKey}}

### Best-effort thread-wide stop (not run-specific cancellation)

POST {{baseUrl}}/v1/chat/threads/{{threadId}}/thinking/stop
Authorization: Bearer {{accessToken}}

### Thread memory

GET {{baseUrl}}/v1/chat/threads/{{threadId}}/memory/state
Authorization: Bearer {{accessToken}}

###

POST {{baseUrl}}/v1/chat/threads/{{threadId}}/memory/mode
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "mode": "manual",
  "discard_pending": false
}

###

POST {{baseUrl}}/v1/chat/threads/{{threadId}}/memory/flush
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "reason": "manual_test"
}

### Dialogues

POST {{baseUrl}}/v1/chat/dialogues/import
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "migrate_legacy": true,
  "rebuild_rag": true,
  "index_rag": true,
  "copy_files": true
}

###

GET {{baseUrl}}/v1/chat/dialogues?thread_id={{threadId}}&limit=20&offset=0
Authorization: Bearer {{accessToken}}

###

GET {{baseUrl}}/v1/chat/dialogues/{{dialogueId}}
Authorization: Bearer {{accessToken}}

###
### Batch dialogue upload returns SSE progress events.
POST {{baseUrl}}/v1/chat/dialogues/upload
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=DialogueBoundary

--DialogueBoundary
Content-Disposition: form-data; name="rebuild_rag"

false
--DialogueBoundary
Content-Disposition: form-data; name="index_rag"

true
--DialogueBoundary
Content-Disposition: form-data; name="files"; filename="dialogue.json"
Content-Type: application/json

< {{dialogueFile}}
--DialogueBoundary--

### Schedules

GET {{baseUrl}}/v1/chat/threads/{{threadId}}/schedules
Authorization: Bearer {{accessToken}}

###

GET {{baseUrl}}/v1/chat/threads/{{threadId}}/schedules?include_completed=true&limit=20&keyword=&statuses=
Authorization: Bearer {{accessToken}}

###

GET {{baseUrl}}/v1/chat/threads/{{threadId}}/schedules/heartbeat
Authorization: Bearer {{accessToken}}

###

POST {{baseUrl}}/v1/chat/threads/{{threadId}}/schedules
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "text": "The scheduled weekly report submission time has arrived; submit the report now.",
  "due_at": "2026-04-06T09:30",
  "timezone_name": "Asia/Shanghai"
}

###

GET {{baseUrl}}/v1/chat/threads/{{threadId}}/schedules/{{scheduleId}}
Authorization: Bearer {{accessToken}}

###

DELETE {{baseUrl}}/v1/chat/threads/{{threadId}}/schedules/{{scheduleId}}
Authorization: Bearer {{accessToken}}
